# ---- Web (apps/web) ----
DATABASE_URL=postgresql://astromax:astromax@localhost:5432/astromax
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
ENGINE_URL=http://localhost:8000
ENGINE_KEY=change-me-shared-hmac-secret

# Payments (Razorpay) — use rzp_test_ keys outside production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Scheduling / video
CALCOM_API_URL=http://localhost:3001/api/v2
CALCOM_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email / newsletter
RESEND_API_KEY=
# Or SMTP instead of Resend (used when SMTP_USER+SMTP_PASS are set). Gmail: SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char App Password>; host/port default to smtp.gmail.com:465. No domain needed.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Resend: sender must be on a domain verified in Resend, e.g. "Marg Darshan <no-reply@yourdomain.com>"
EMAIL_FROM=
# Where customer replies go (optional), e.g. support@yourdomain.com
EMAIL_REPLY_TO=
LISTMONK_URL=http://localhost:9000
LISTMONK_USER=
LISTMONK_PASSWORD=

# Storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=astromax

# ---- Engine (apps/engine) ----
REDIS_URL=redis://localhost:6379/0
GEOCODER_USER_AGENT=Astromax/0.1 (+https://github.com/astromax)

# Cron (Vercel sends "Authorization: Bearer $CRON_SECRET"; other schedulers may send x-cron-secret)
CRON_SECRET=
# Jyotish pre-read emails (booking briefing + T-2h resend); unset = skipped
JYOTISH_EMAIL=
# HMAC secret for client "manage booking" links
MANAGE_LINK_SECRET=
# Admin panel
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD=
JYOTISH_PASSWORD=
# GST invoice issuer details
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
BUSINESS_STATE_CODE=

# Newsletter digest (engine weekly draft campaign)
LISTMONK_LIST_IDS=

# AGPL: public URL of the astro engine source (apps/engine)
NEXT_PUBLIC_ENGINE_SOURCE_URL=

# Analytics (Plausible, cookie-free). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Self-hosted natural voice (apps/voice, Piper)
VOICE_URL=http://127.0.0.1:8001

# AMX-206 biodata reading (Claude vision). Leave empty to disable the upload.
ANTHROPIC_API_KEY=
