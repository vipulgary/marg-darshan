// Astromax data model v1 (AMX-004) — see "Final Plan.md" §3.
// The web app owns this schema; the Python engine reads/writes `horoscopes` and
// `rectification_scans` with SQLAlchemy against the same tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Lang {
  hi
  en
}

enum ServiceType {
  JYOTISH
  VASTU
  GEMS
  RECTIFICATION
}

enum VisitMode {
  ONLINE_ZOOM
  PERSONAL_VISIT
}

enum PlanType {
  FULL_UPFRONT
  SPLIT_PLAN
}

enum AppointmentStatus {
  DRAFT
  HELD
  PENDING_PAYMENT
  PARTIALLY_PAID
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  NO_SHOW
  REFUNDED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentChannel {
  UPI_INTENT
  UPI_QR
  UPI_ID
  NET_BANKING
  CARD
  WALLET
  OTHER
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum ProductCategory {
  GEM
  RUDRAKSHA
  YANTRA
  VASTU
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  fullName      String   @map("full_name")
  email         String?  @unique
  whatsappPhone String?  @map("whatsapp_phone")
  preferredLang Lang     @default(hi) @map("preferred_lang")
  createdAt     DateTime @default(now()) @map("created_at")

  // Customer accounts (AMX-170..173). Kept on Client (1:1 by email) so every booking, kundali
  // and enquiry already keyed to the client becomes visible once the email is verified.
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String?   @map("password_hash") // "scrypt$v1$N$r$p$salt$hash"
  googleSub       String?   @unique @map("google_sub")
  avatarUrl       String?   @map("avatar_url")

  birthProfiles BirthProfile[]
  appointments  Appointment[]
  enquiries     ShopEnquiry[]
  sessions      Session[]
  authTokens    AuthToken[]

  @@index([whatsappPhone])
  @@map("clients")
}

model BirthProfile {
  id                String    @id @default(uuid()) @db.Uuid
  clientId          String?   @map("client_id") @db.Uuid
  label             String? // "Self", "Mother" … (saved profiles in /account/profiles)
  fullName          String?   @map("full_name") // the chart's subject (may differ from the account holder)
  gender            String?
  dob               DateTime? @db.Date
  tob               DateTime? @db.Time(0)
  isTimeUnknown     Boolean   @default(false) @map("is_time_unknown")
  isDateUnknown     Boolean   @default(false) @map("is_date_unknown")
  approxWindowStart DateTime? @map("approx_window_start") @db.Time(0)
  approxWindowEnd   DateTime? @map("approx_window_end") @db.Time(0)
  placeName         String    @map("place_name")
  latitude          Decimal   @db.Decimal(9, 6)
  longitude         Decimal   @db.Decimal(9, 6)
  tzName            String    @map("tz_name")
  tzOffset          Decimal?  @map("tz_offset") @db.Decimal(4, 2)
  lifeEvents        Json?     @map("life_events_json")
  prashnaTs         DateTime? @map("prashna_ts")
  prashnaLat        Decimal?  @map("prashna_lat") @db.Decimal(9, 6)
  prashnaLng        Decimal?  @map("prashna_lng") @db.Decimal(9, 6)
  createdAt         DateTime  @default(now()) @map("created_at")

  client       Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  horoscopes   Horoscope[]
  scans        RectificationScan[]
  appointments Appointment[]

  @@map("birth_profiles")
}

model Horoscope {
  id             String    @id @default(uuid()) @db.Uuid
  birthProfileId String    @map("birth_profile_id") @db.Uuid
  inputHash      String    @map("input_hash") // cache key: same normalised input -> same horoscope
  ayanamsa       String    @default("LAHIRI")
  lang           Lang      @default(hi)
  chartStyle     String    @default("north") @map("chart_style")
  chartJson      Json?     @map("chart_json")
  vargasJson     Json?     @map("d1_d60_json")
  yogasDoshas    Json?     @map("yogas_doshas_json")
  northSvgUrl    String?   @map("north_svg_url")
  southSvgUrl    String?   @map("south_svg_url")
  pdfUrl         String?   @map("pdf_url")
  status         JobStatus @default(QUEUED)
  error          String?
  emailedAt      DateTime? @map("emailed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  birthProfile BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)

  @@index([inputHash])
  @@map("horoscopes")
}

model RectificationScan {
  id             String    @id @default(uuid()) @db.Uuid
  birthProfileId String    @map("birth_profile_id") @db.Uuid
  candidates     Json?     @map("candidates_json")
  dossierPdfUrl  String?   @map("dossier_pdf_url")
  status         JobStatus @default(QUEUED)
  createdAt      DateTime  @default(now()) @map("created_at")

  birthProfile BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)

  @@map("rectification_scans")
}

model Problem {
  id              String      @id @default(uuid()) @db.Uuid
  slug            String      @unique
  titleHi         String      @map("title_hi")
  titleEn         String      @map("title_en")
  icon            String
  serviceType     ServiceType @map("service_type")
  defaultDuration Int         @map("default_duration")
  sort            Int         @default(0)
  active          Boolean     @default(true)

  appointments Appointment[]
  enquiries    ShopEnquiry[]

  @@map("problems")
}

model Service {
  id           String      @id @default(uuid()) @db.Uuid
  slug         String      @unique
  serviceType  ServiceType @map("service_type")
  titleHi      String      @map("title_hi")
  titleEn      String      @map("title_en")
  modes        VisitMode[]
  durations    Int[]
  basePriceInr Int         @map("base_price_inr")
  splitAllowed Boolean     @default(false) @map("split_allowed")
  calEventSlug String?     @map("cal_event_slug")
  active       Boolean     @default(true)

  plans        Plan[]
  appointments Appointment[]

  @@map("services")
}

model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  slug       String   @unique
  nameHi     String   @map("name_hi")
  nameEn     String   @map("name_en")
  priceInr   Int      @map("price_inr")
  sessions   Int      @default(1)
  durationMin Int     @map("duration_min")
  planType   PlanType @default(FULL_UPFRONT) @map("plan_type")
  advancePct Int?     @map("advance_pct")
  featured   Boolean  @default(false)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("plans")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  birthProfileId     String?           @map("birth_profile_id") @db.Uuid
  problemId          String            @map("problem_id") @db.Uuid
  problemDescription String?           @map("problem_description")
  serviceId          String            @map("service_id") @db.Uuid
  visitMode          VisitMode         @map("visit_mode")
  durationMins       Int               @map("duration_mins")
  planType           PlanType          @default(FULL_UPFRONT) @map("plan_type")
  slotStart          DateTime          @map("slot_start")
  slotEnd            DateTime          @map("slot_end")
  calBookingUid      String?           @unique @map("cal_booking_uid")
  zoomUrl            String?           @map("zoom_url")
  vastuProperty      Json?             @map("vastu_property_json")
  vastuMapUrl        String?           @map("vastu_map_url")
  status             AppointmentStatus @default(DRAFT)
  holdExpiresAt      DateTime?         @map("hold_expires_at")
  sessionNotes       String?           @map("session_notes") // Jyotish's private notes (admin only)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  client       Client        @relation(fields: [clientId], references: [id])
  birthProfile BirthProfile? @relation(fields: [birthProfileId], references: [id])
  problem      Problem       @relation(fields: [problemId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  payments     Payment[]

  @@index([status, holdExpiresAt])
  @@index([slotStart])
  @@map("appointments")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  appointmentId     String          @map("appointment_id") @db.Uuid
  planType          PlanType        @map("plan_type")
  installmentNo     Int             @default(1) @map("installment_no")
  totalInr          Int             @map("total_inr")
  amountInr         Int             @map("amount_inr")
  balanceDueInr     Int             @default(0) @map("balance_due_inr")
  channel           PaymentChannel?
  razorpayOrderId   String?         @unique @map("razorpay_order_id")
  razorpayPaymentId String?         @unique @map("razorpay_payment_id")
  razorpayLinkId    String?         @unique @map("razorpay_link_id")
  status            PaymentStatus   @default(CREATED)
  rawWebhook        Json?           @map("raw_webhook_json")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  invoice     Invoice?

  @@unique([appointmentId, installmentNo])
  @@map("payments")
}

// GST tax invoice per captured payment (AMX-085). Numbers are gap-free per Indian financial year.
model Invoice {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @unique @map("payment_id") @db.Uuid
  fy          String // "2026-27"
  seq         Int
  number      String   @unique // AMX/2026-27/00001
  issuedAt    DateTime @default(now()) @map("issued_at")
  totalPaise  Int      @map("total_paise")
  taxablePaise Int     @map("taxable_paise")
  cgstPaise   Int      @default(0) @map("cgst_paise")
  sgstPaise   Int      @default(0) @map("sgst_paise")
  igstPaise   Int      @default(0) @map("igst_paise")
  breakdown   Json // seller, buyer, line items, place of supply — frozen at issue time

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([fy, seq])
  @@map("invoices")
}

model Product {
  id        String          @id @default(uuid()) @db.Uuid
  slug      String          @unique
  sku       String          @unique
  category  ProductCategory
  titleHi   String          @map("title_hi")
  titleEn   String          @map("title_en")
  descHi    String          @map("desc_hi")
  descEn    String          @map("desc_en")
  images    String[]
  priceHint String?         @map("price_hint")
  certified Boolean         @default(false)
  active    Boolean         @default(true)

  enquiries ShopEnquiry[]

  @@map("products")
}

model ShopEnquiry {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String?  @map("client_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  problemId          String?  @map("problem_id") @db.Uuid
  name               String
  phone              String
  customerNote       String?  @map("customer_note")
  whatsappRedirected Boolean  @default(false) @map("whatsapp_redirected")
  createdAt          DateTime @default(now()) @map("created_at")

  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  product Product  @relation(fields: [productId], references: [id])
  problem Problem? @relation(fields: [problemId], references: [id])

  @@map("shop_enquiries")
}

model NewsletterSub {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  whatsappPhone String?          @map("whatsapp_phone")
  language      Lang             @default(hi)
  status        SubscriberStatus @default(PENDING)
  token         String           @unique @default(uuid())
  createdAt     DateTime         @default(now()) @map("created_at")

  @@map("newsletter_subs")
}

model NotificationLog {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel
  template  String
  to        String
  entityId  String?             @map("entity_id")
  status    String
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([entityId])
  @@map("notification_log")
}

// Idempotency for Razorpay / Cal.com webhooks: a duplicate event_id is rejected by the unique index.
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// AMX-143: admin-editable business settings, one JSON value per key, merged over catalog defaults.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

// Revocable customer sessions; the cookie holds a random token, only its SHA-256 is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  userAgent String?  @map("user_agent")
  ip        String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("sessions")
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// Single-use emailed links (email verification, password reset); only the SHA-256 is stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  clientId  String           @map("client_id") @db.Uuid
  tokenHash String           @unique @map("token_hash")
  purpose   AuthTokenPurpose
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, purpose])
  @@map("auth_tokens")
}
